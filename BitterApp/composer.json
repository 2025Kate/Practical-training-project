{
    "name": "bitter/app",
    "description": "Bitter Application with Laravel backend and Vue frontend",
    "type": "project",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "symfony/process": "^6.0"
    },
    "scripts": {
        "install-deps": [
            "@install-laravel-deps",
            "@install-vue-deps"
        ],
        "install-laravel-deps": [
            "echo 'Installing Laravel dependencies...'",
            "composer install --working-dir=bitter-laravel"
        ],
        "install-vue-deps": [
            "echo 'Installing Vue dependencies...'",
            "npm install --prefix bitter-vue"
        ],
        "dev": [
            "echo 'Starting both servers...'",
            "php bin/start-servers"
        ],
        "laravel-serve": "php artisan serve --port=8000 --working-dir=bitter-laravel",
        "vue-dev": "npm run dev --prefix bitter-vue"
    }
}
